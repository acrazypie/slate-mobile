<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon. The launcher masks it to a circle, rounded square or squircle, so the
     artwork is inset to the 66% safe zone; otherwise its corners and rings get cut off. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background_oled" />
    <foreground>
        <inset android:drawable="@mipmap/ic_launcher_sage_oled_foreground" android:inset="16.7%" />
    </foreground>
</adaptive-icon>
