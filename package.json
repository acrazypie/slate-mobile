{
  "name": "slate-app",
  "version": "1.0.0",
  "private": true,
  "description": "Slate, the time-block weekly planner, as a local-only iOS and Android app built with Capacitor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx scripts/test-recurrence.ts && tsx scripts/test-data.ts && tsx scripts/test-pay-rotations.ts && tsx scripts/test-google.ts && tsx scripts/test-update.ts && tsx scripts/test-donate.ts && tsx scripts/test-notify.ts && tsx scripts/test-summary.ts",
    "preview": "vite preview",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "assets": "node scripts/make-assets.mjs && capacitor-assets generate --ios --android --iconBackgroundColor '#6BB6A3' --iconBackgroundColorDark '#6BB6A3' --splashBackgroundColor '#F4F6FA' --splashBackgroundColorDark '#0E1320'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "^8.7.13",
    "@ebarooni/capacitor-calendar": "^8.11.0",
    "date-fns": "^4.4.0",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
